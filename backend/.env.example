ENVIRONMENT=production

# Gemini AI (Backend Only - NEVER expose to frontend)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# Supabase PostgreSQL & pgvector (Backend Only - NEVER expose to frontend)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_role_key

# Production CORS (List of allowed frontend domains)
CORS_ORIGINS=["https://your-ventureos-app.vercel.app", "http://localhost:3000"]
